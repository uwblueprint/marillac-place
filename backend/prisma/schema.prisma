generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffType {
  ADMIN
  RELIEF
}

enum TaskType {
  REQUIRED
  OPTIONAL
  CHORE
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  INCOMPLETE
  COMPLETE
  EXCUSED
}

model Participant {
  participant_id    Int           @id
  room_number       Int
  arrival           DateTime
  departure         DateTime?
  is_active         Boolean       
  password          String
  credit_earned     Int           @default(0)

  @@map("participants")
}

model Announcement {
  announcement_id   Int           @id @default(autoincrement())
  from              StaffType     
  to                Int[]         
  createdAt         DateTime
  message           String

  @@map("announcements")
}

model Task {
  task_id           Int           @id @default(autoincrement())
  room_number       Int?
  type              TaskType
  status            TaskStatus  
  name              String
  is_recurring      Boolean
  start             DateTime
  end               DateTime
  credit            Int
  comment           String?

  @@map("tasks")
}
