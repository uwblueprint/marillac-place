generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  EARNING
  PURCHASE
  REFUND
}

enum GoalAction {
  SET
  REACHED
}

enum Priority {
  NORMAL
  HIGH
  CRITICAL
}

enum TaskType {
  REQUIRED
  OPTIONAL
  INDIVIDUAL_GOAL
}

enum TaskStatus {
  ASSIGNED
  INCOMPLETE
  COMPLETE
  EXCUSED
}

enum DayPreference {
  DAILY
  EVERY_SELECTED_DAYS
  ANY_SELECTED_DAYS
  PARTICIPANT_PREFERENCE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimePreference {
  ANYTIME
  SPECIFIC
  PARTICIPANT_PREFERENCE
}

enum Level {
  NOVICE
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum Icon {
  FIVE_STAR
  FOUR_STAR
  GROUP
  HEART
  HOME
  BABY
  WINGS
  FLOWER
  MONEY
  GEMSTONE
  DIAMOND
  PENCIL
  TOOL
}

model Participant {
  pid       Int       @id
  password  String
  room      Int
  arrival   DateTime  @default(now())
  departure DateTime?
  balance   Int       @default(0)

  Transaction          Transaction[]
  EarningGoal          EarningGoal[]
  LoginHistory         LoginHistory[]
  ReceivedAnnouncement ReceivedAnnouncement[]
  AssignedTask         AssignedTask[]
  EarnedCustomBadge    EarnedCustomBadge[]
  AchievedBadgeLevel   AchievedBadgeLevel[]
  BadgeLevelProgress   BadgeLevelProgress[]

  @@map("participant")
}

model Transaction {
  pid    Int
  date   DateTime        @default(now())
  amount Int
  type   TransactionType @default(EARNING)
  reason String

  participant Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([pid, date])
  @@map("transaction")
}

model EarningGoal {
  pid    Int
  action GoalAction
  date   DateTime   @default(now())
  value  Int

  participant Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([pid, date])
  @@map("earning_goal")
}

model LoginHistory {
  pid  Int
  date DateTime @default(now())

  participant Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([pid, date])
  @@map("login_history")
}

model Announcement {
  aid      Int      @id @default(autoincrement())
  date     DateTime @default(now())
  message  String
  priority Priority @default(NORMAL)

  ReceivedAnnouncement ReceivedAnnouncement[]

  @@map("announcement")
}

model ReceivedAnnouncement {
  aid    Int
  pid    Int
  read   Boolean @default(false)
  pinned Boolean @default(false)

  announcement Announcement @relation(fields: [aid], references: [aid], onDelete: Cascade, onUpdate: Cascade)
  participant  Participant  @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([aid, pid])
  @@map("received_announcement")
}

model Task {
  name            String         @id
  type            TaskType
  description     String
  value           Int
  penalty         Int
  comment         String?
  day_preference  DayPreference
  days            DayOfWeek[]
  time_preference TimePreference
  start_time      DateTime       @db.Time
  end_time        DateTime       @db.Time

  AssignedTask AssignedTask[]

  @@map("task")
}

model AssignedTask {
  name       String
  pid        Int
  status     TaskStatus @default(ASSIGNED)
  value      Int
  penalty    Int
  comment    String?
  start_date DateTime
  end_date   DateTime

  task        Task        @relation(fields: [name], references: [name], onDelete: Cascade, onUpdate: Cascade)
  participant Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([name, pid])
  @@map("assigned_task")
}

model CustomBadge {
  name        String @id
  icon        Icon
  description String

  EarnedCustomBadge EarnedCustomBadge[]

  @@map("custom_badge")
}

model EarnedCustomBadge {
  name String
  pid  Int

  participant  Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)
  custom_badge CustomBadge @relation(fields: [name], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@id([name, pid])
  @@map("earned_custom_badge")
}

model SystemBadge {
  name        String  @id
  icon        Icon
  description String
  is_active   Boolean @default(true)

  BadgeLevel BadgeLevel[]

  @@map("system_badge")
}

model BadgeLevel {
  name      String
  level     Level
  value     Int
  benchmark Int

  AchievedBadgeLevel AchievedBadgeLevel[]
  BadgeLevelProgress BadgeLevelProgress[]

  system_badge SystemBadge @relation(fields: [name], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@id([name, level])
  @@map("badge_level")
}

model AchievedBadgeLevel {
  name  String
  level Level
  pid   Int

  badge_level BadgeLevel  @relation(fields: [name, level], references: [name, level], onDelete: Cascade, onUpdate: Cascade)
  participant Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([name, level, pid])
  @@map("achieved_badge_level")
}

model BadgeLevelProgress {
  name        String
  level       Level
  pid         Int
  progress    Int
  lost_streak Boolean @default(false)

  badge_level BadgeLevel  @relation(fields: [name, level], references: [name, level], onDelete: Cascade, onUpdate: Cascade)
  participant Participant @relation(fields: [pid], references: [pid], onDelete: Cascade, onUpdate: Cascade)

  @@id([name, level, pid])
  @@map("badge_level_progress")
}

model Note {
  nid     Int      @id @default(autoincrement())
  message String
  date    DateTime @default(now())

  @@map("note")
}

model ReportRecipient {
  email   String  @id
  weekly  Boolean @default(true)
  monthly Boolean @default(true)

  @@map("report_recipient")
}
