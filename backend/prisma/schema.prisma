generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffType {
  ADMIN
  RELIEF
}

enum TaskType {
  REQUIRED
  OPTIONAL
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  INCOMPLETE
  PENDING
  COMPLETE
  EXCUSED
}

model Participant {
  participantId     String        @id
  roomNumber        Int
  arrival           String
  departure         String?     
  password          String
  credit            Int           @default(0)

  @@map("participants")
}

model Announcement {
  announcementId    Int           @id @default(autoincrement())
  from              StaffType     
  to                Int[]         
  createdAt         DateTime
  message           String

  @@map("announcements")
}

model Task {
  taskId            Int           @id @default(autoincrement())
  roomNumber        Int?
  type              TaskType
  status            TaskStatus  
  name              String
  isRecurring       Boolean
  start             DateTime
  end               DateTime
  credit            Int
  comment           String?

  @@map("tasks")
}

model Note {
  noteId            Int           @id @default(autoincrement())
  message           String
  date              String
}