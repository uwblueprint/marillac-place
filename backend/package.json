{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "lint": "eslint . --ext .ts,.js",
    "fix": "eslint . --ext .ts,.js --fix",
    "postinstall": "npx prisma generate && tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "start": "npx prisma migrate deploy && npx prisma generate && npx @snaplet/seed sync && npx prisma db seed && if [ \"$NODE_ENV\" = \"production\" ]; then node build/server.js; else nodemon -L; fi",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:coverage": "npx c8 --reporter=lcov --reporter=text-summary --reports-dir coverage tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:coverage:unit": "npx c8 --clean --reporter=lcov --reporter=text-summary --reports-dir coverage/unit tsx --test tests/unit/*.test.ts",
    "test:coverage:integration": "npx c8 --clean --reporter=lcov --reporter=text-summary --reports-dir coverage/integration tsx --test tests/integration/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.9.0",
