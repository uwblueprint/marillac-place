    "@types/multer": "^1.4.6",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.2",
    "@types/uuid": "^8.3.1",
    "@types/yamljs": "^0.2.31",
    "apollo-server": "^2.22.2",
    "apollo-server-express": "^2.22.2",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "graphql": "15.5.0",
    "graphql-middleware": "^6.0.6",
    "graphql-scalars": "^1.22.4",
    "graphql-upload": "^12.0.0",
    "json2csv": "^5.0.6",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.2",
